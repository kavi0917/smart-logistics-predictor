# Copy to .env (cp .env.example .env). Never commit .env.
# ---- database (Docker: host is the compose service name "postgres") ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=logistics
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/logistics
# For running the backend OUTSIDE Docker use host "localhost" instead of "postgres",
# or delete DATABASE_URL to fall back to a local SQLite file (see SETUP.md).

# ---- backend ----
SECRET_KEY=change-this-secret
JWT_EXPIRE_MINUTES=60
MODEL_PATH=models/eta_model.joblib
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true

# ---- risk thresholds (optional overrides; ratio = predicted / promised) ----
# RISK_MEDIUM_RATIO=1.0
# RISK_HIGH_RATIO=1.15

# ---- frontend (address the BROWSER uses to reach the backend) ----
VITE_API_URL=http://localhost:8000
